<Window x:Class="GitHubAccountManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Account Manager" Width="1180" Height="780" MinWidth="980" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
 <TabControl x:Name="MainNavigation" TabStripPlacement="Left" SelectedIndex="0">
  <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,24,16,20"><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock Text="GH" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="White"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Account Manager" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel></StackPanel></StackPanel>
    <TabPanel Grid.Row="1" IsItemsHost="True" Margin="0,4,0,0"/>
    <StackPanel Grid.Row="2" Margin="20,14,16,20"><Border Height="1" Background="{StaticResource BorderMutedBrush}" Margin="0,0,0,14"/><TextBlock Text="SAFE WORKSPACE" Style="{StaticResource Eyebrow}"/><TextBlock Text="v0.1.2 beta" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,0,1" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="REPOSITORY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Local workspace" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
     <TextBox Grid.Column="1" Text="{Binding RepositoryPath,UpdateSourceTrigger=PropertyChanged}" Margin="0" MinHeight="38"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"><Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Browse" Click="Browse_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/><Button Content="Open terminal" Click="Terminal_Click" Margin="0"/></StackPanel>
    </Grid></Border>
    <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" TextElement.Foreground="{StaticResource TextBrush}"><ContentPresenter x:Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"/></Border>
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel><ProgressBar Width="120" HorizontalAlignment="Right" IsIndeterminate="{Binding IsBusy}"/></Grid></Border>
   </Grid>
  </Grid></ControlTemplate></TabControl.Template>

  <TabItem Header="Overview" Tag="&#xE80F;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="1180" HorizontalAlignment="Stretch">
   <TextBlock Text="Repository overview" Style="{StaticResource PageTitle}"/><TextBlock Text="Everything important about this workspace, at a glance." Style="{StaticResource PageSubtitle}"/>
   <UniformGrid Columns="4" Margin="0,0,-12,8">
    <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="BRANCH" Style="{StaticResource Eyebrow}"/><Border HorizontalAlignment="Right" Background="#331F6FEB" CornerRadius="6" Padding="8,5"><TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF"/></Border></Grid><TextBlock Text="{Binding Branch}" Style="{StaticResource Metric}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="ACCOUNT" Style="{StaticResource Eyebrow}"/><Border HorizontalAlignment="Right" Background="#223FB950" CornerRadius="6" Padding="8,5"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}"/></Border></Grid><TextBlock Text="{Binding CurrentAccount}" Style="{StaticResource Metric}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="SYNC" Style="{StaticResource Eyebrow}"/><Border HorizontalAlignment="Right" Background="#22D29922" CornerRadius="6" Padding="8,5"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}"/></Border></Grid><TextBlock Text="{Binding SyncState}" Style="{StaticResource Metric}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="CHANGES" Style="{StaticResource Eyebrow}"/><Border HorizontalAlignment="Right" Background="#22A371F7" CornerRadius="6" Padding="8,5"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#BC8CFF"/></Border></Grid><TextBlock Text="{Binding ChangeCount}" Style="{StaticResource Metric}"/></StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,0,-12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Repository details" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Identity" Foreground="{StaticResource MutedBrush}" Margin="0,7"/><TextBlock Grid.Column="1" Text="{Binding Identity}" Margin="0,7" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="1" Text="Remote" Foreground="{StaticResource MutedBrush}" Margin="0,7"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RemoteUrl}" Margin="0,7" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Text="Upstream" Foreground="{StaticResource MutedBrush}" Margin="0,7"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Upstream}" Margin="0,7"/>
    </Grid></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Quick sync" Style="{StaticResource SectionTitle}"/><TextBlock Text="Network operations use safe defaults and clear timeouts." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><WrapPanel><Button Content="Fetch" Click="Fetch_Click"/><Button Content="Pull" Click="Pull_Click"/><Button Style="{StaticResource SuccessButton}" Content="Push" Click="Push_Click"/><Button Content="Push dry-run" Click="PushDryRun_Click"/><Button Content="Stash all" Click="Stash_Click"/></WrapPanel></StackPanel></Border>
   </Grid>
  </StackPanel></ScrollViewer></TabItem>

  <TabItem Header="Changes" Tag="&#xE8FD;"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Working tree" Style="{StaticResource PageTitle}"/><TextBlock Text="Review, stage and commit changes without leaving the workspace." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12"><DataGrid x:Name="ChangesGrid" ItemsSource="{Binding Changes}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="FILE" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Stage files" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Stage selected" Click="StageSelected_Click"/><Button Content="Stage all" Click="StageAll_Click"/><Button Content="Unstage" Click="UnstageSelected_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/></StackPanel></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CommitMessage,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,12,0" ToolTip="Describe your changes"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Commit" Click="Commit_Click"/><Button Style="{StaticResource SuccessButton}" Content="Commit &amp; push" Click="CommitPush_Click" Margin="0"/></StackPanel></Grid></Grid></Border>
  </Grid></TabItem>

  <TabItem Header="Accounts &amp; SSH" Tag="&#xE77B;"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Accounts &amp; SSH" Style="{StaticResource PageTitle}"/><TextBlock Text="Keep author identity, SSH keys and remotes aligned per repository." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Profiles" Style="{StaticResource SectionTitle}"/><ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" SelectionChanged="AccountSelection_Changed"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Add account" Click="AddAccount_Click"/><Button Style="{StaticResource DangerButton}" Content="Delete" Click="DeleteAccount_Click"/></StackPanel></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Profile details" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource InsetCard}" Margin="0,0,0,18"><StackPanel><TextBlock Text="GitHub authentication" FontWeight="SemiBold" FontSize="15"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="8" Height="8" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubAuthenticated}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding GitHubAuthStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel><TextBlock Text="Browser sign-in is stored securely by Git Credential Manager. SSH access is configured separately below." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Sign in with GitHub" Click="SignInGitHub_Click"/><Button Content="Refresh" Click="RefreshAuth_Click"/><Button Style="{StaticResource DangerButton}" Content="Sign out" Click="SignOutGitHub_Click" Margin="0"/></WrapPanel></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Display name"/><TextBox Text="{Binding SelectedAccount.DisplayName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Git author name"/><TextBox Text="{Binding SelectedAccount.GitUserName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Git email"/><TextBox Text="{Binding SelectedAccount.GitEmail,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="GitHub username"/><TextBox Text="{Binding SelectedAccount.GitHubUser,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="GitHub host"/><TextBox Text="{Binding SelectedAccount.HostName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SSH alias"/><TextBox Text="{Binding SelectedAccount.SshAlias,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Private key path"/><TextBox Text="{Binding SelectedAccount.PrivateKeyPath,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Signing public key"/><TextBox Text="{Binding SelectedAccount.SigningKeyPath,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Sign commits with this SSH key" IsChecked="{Binding SelectedAccount.EnableCommitSigning}"/></StackPanel>
    </Grid></StackPanel></ScrollViewer><StackPanel Grid.Row="1"><Border Height="1" Background="{StaticResource BorderMutedBrush}" Margin="0,12,0,14"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Save profile" Click="SaveAccounts_Click"/><Button Content="Preview switch" Click="PreviewSwitch_Click"/><Button Content="Identity only" Click="IdentitySwitch_Click"/><Button Style="{StaticResource SuccessButton}" Content="Full switch" Click="FullSwitch_Click"/><Button Content="Setup SSH" Click="SetupSsh_Click"/><Button Content="Test SSH" Click="TestSsh_Click"/><Button Content="Generate key" Click="GenerateKey_Click"/><Button Content="Add to agent" Click="AddAgent_Click"/><Button Content="Restore backup" Click="RestoreBackup_Click"/></WrapPanel></StackPanel></Grid></Border>
   </Grid>
  </Grid></TabItem>

  <TabItem Header="Repository" Tag="&#xE838;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="1000">
   <TextBlock Text="Repository setup" Style="{StaticResource PageTitle}"/><TextBlock Text="Initialize, connect or publish this folder to GitHub." Style="{StaticResource PageSubtitle}"/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Local &amp; remote" Style="{StaticResource SectionTitle}"/><TextBlock Text="Remote URL or owner/repository" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RemoteInput,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel><Button Content="Initialize Git" Click="Init_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Set remote" Click="SetRemote_Click"/><Button Content="Create starter .gitignore" Click="GitIgnore_Click"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0"><StackPanel><DockPanel><StackPanel><TextBlock Text="Create on GitHub" Style="{StaticResource SectionTitle}" Margin="0"/><TextBlock Text="Uses your signed-in account, or an optional fine-grained token for this operation only." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel><Border DockPanel.Dock="Right" Background="#223FB950" CornerRadius="12" Padding="10,4" VerticalAlignment="Top"><TextBlock Text="CREDENTIALS STORED SECURELY" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold"/></Border></DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Repository name"/><TextBox Text="{Binding NewRepositoryName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Description"/><TextBox Text="{Binding NewRepositoryDescription,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Commit message"/><TextBox Text="{Binding InitialCommitMessage,UpdateSourceTrigger=PropertyChanged}" ToolTip="Used only when Create remote &amp; push commits current changes."/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fine-grained token (optional)"/><PasswordBox x:Name="TokenBox" ToolTip="Leave blank to use the account signed in from Accounts &amp; SSH."/><CheckBox Content="Create as private repository" IsChecked="{Binding NewRepositoryPrivate}"/><CheckBox Content="Use SSH remote instead of HTTPS" IsChecked="{Binding UseSshRemote}" ToolTip="HTTPS uses your browser sign-in. SSH requires a configured and uploaded SSH key."/><TextBlock Text="Create remote &amp; push initializes Git when needed, checks for likely secrets, commits all non-ignored changes, configures origin, and pushes the current branch." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,13"/><WrapPanel><Button Style="{StaticResource SuccessButton}" Content="Create remote &amp; push" Click="PublishGitHub_Click"/><Button Content="Create remote only" Click="CreateGitHub_Click"/><Button Content="Upload SSH public key" Click="UploadKey_Click"/></WrapPanel></StackPanel></Grid>
   </StackPanel></Border>
  </StackPanel></ScrollViewer></TabItem>

  <TabItem Header="Branches &amp; history" Tag="&#xE895;"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Branches &amp; history" Style="{StaticResource PageTitle}"/><TextBlock Text="Move between lines of work and inspect recent commits." Style="{StaticResource PageSubtitle}"/></StackPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Local branches" Style="{StaticResource SectionTitle}"/><ListBox Grid.Row="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"/><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBox Text="{Binding NewBranchName}" ToolTip="New branch name"/><WrapPanel><Button Style="{StaticResource PrimaryButton}" Content="Create branch" Click="CreateBranch_Click"/><Button Content="Switch" Click="SwitchBranch_Click"/></WrapPanel></StackPanel></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0"><DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="HASH" Binding="{Binding Hash}" Width="90"/><DataGridTextColumn Header="COMMIT" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="150"/><DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="165"/></DataGrid.Columns></DataGrid></Border></Grid>
  </Grid></TabItem>

  <TabItem Header="Diagnostics" Tag="&#xE9D9;"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}"/><TextBlock Text="Inspect Git, SSH and application state without collecting secrets." Style="{StaticResource PageSubtitle}"/></StackPanel><WrapPanel Grid.Row="1"><Button Style="{StaticResource PrimaryButton}" Content="Run diagnostics" Click="Diagnostics_Click"/><Button Content="Copy log" Click="CopyLog_Click"/><Button Style="{StaticResource DangerButton}" Content="Clear" Click="ClearLog_Click"/></WrapPanel><Border Grid.Row="2" Style="{StaticResource InsetCard}" Padding="0" Margin="0"><TextBox Text="{Binding LogText,Mode=OneWay}" FontFamily="Cascadia Mono,Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Margin="0" Padding="16"/></Border></Grid></TabItem>
 </TabControl>
</Window>
